# 麦当劳 MCP 配置
# 1. 赛前用手机号登录 https://mcp.mcd.cn 申请 MCP Token
# 2. 复制本文件为 .env 并填入 Token
# 3. npm start 启动后即为「实时模式」（真实菜单 / 真实领券 / 真实下单）
#    未配置 Token 时应用启动后展示「需配置后端」提示页，不提供任何模拟数据

MCD_MCP_TOKEN=在此粘贴你的MCP_Token

# 服务端口（默认 3210）
PORT=3210

# 公网访问限流（可选，不填则用默认值）
# 写操作（下单/领券）：每 IP 每 10 分钟最多 20 次；读操作：每 IP 每分钟最多 600 次
# /api/status 不受限流影响；Cloudflare Pages 部署时按 cf-connecting-ip 计算
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_READ_MAX=600
